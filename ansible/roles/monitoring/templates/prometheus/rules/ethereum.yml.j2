groups:
  - name: ethereum-node
    rules:
      - alert: EthereumNodeExporterDown
        expr: up{job="ethereum_node"} == 0
        for: 2m
        labels:
          severity: critical
          component: host
        annotations:
          summary: "Ethereum node exporter is unreachable"
          description: "Prometheus has been unable to scrape the Ethereum host for more than 2 minutes."
          runbook_url: "https://github.com/kemlohko/blockchain-sre-platform/blob/main/docs/runbooks/ethereum-node-down.md"

      - alert: GethDown
        expr: up{job="geth"} == 0
        for: 2m
        labels:
          severity: critical
          component: execution
        annotations:
          summary: "Geth metrics endpoint is unreachable"
          description: "Prometheus has been unable to scrape Geth for more than 2 minutes."
          runbook_url: "https://github.com/kemlohko/blockchain-sre-platform/blob/main/docs/runbooks/geth-service-down.md"

      - alert: LighthouseDown
        expr: up{job="lighthouse"} == 0
        for: 2m
        labels:
          severity: critical
          component: consensus
        annotations:
          summary: "Lighthouse metrics endpoint is unreachable"
          description: "Prometheus has been unable to scrape Lighthouse for more than 2 minutes."
          runbook_url: "https://github.com/kemlohko/blockchain-sre-platform/blob/main/docs/runbooks/lighthouse-service-down.md"

      - alert: ConsensusNotSynced
        expr: sync_eth2_synced{job="lighthouse"} == 0
        for: 5m
        labels:
          severity: critical
          component: consensus
        annotations:
          summary: "Lighthouse is not synchronized"
          description: "Lighthouse has reported an unsynchronized state for more than 5 minutes."
          runbook_url: "https://github.com/kemlohko/blockchain-sre-platform/blob/main/docs/runbooks/lighthouse-not-syncing.md"
    
      - alert: RootDiskUsageHigh
        expr: |
          100 * (
            1 -
            node_filesystem_avail_bytes{
              job="ethereum_node",
              mountpoint="/",
              fstype!="rootfs"
            }
            /
            node_filesystem_size_bytes{
              job="ethereum_node",
              mountpoint="/",
              fstype!="rootfs"
            }
          ) > 85
        for: 10m
        labels:
          severity: warning
          component: storage
        annotations:
          summary: "Ethereum node root filesystem usage is high"
          description: "Root filesystem usage has exceeded 85% for more than 10 minutes."
          runbook_url: "https://github.com/kemlohko/blockchain-sre-platform/blob/main/docs/runbooks/high-disk-usage.md"

      - alert: AncientDiskUsageHigh
        expr: |
          100 * (
            1 -
            node_filesystem_avail_bytes{
              job="ethereum_node",
              mountpoint="/mnt/ethereum-ancient",
              fstype!="rootfs"
            }
            /
            node_filesystem_size_bytes{
              job="ethereum_node",
              mountpoint="/mnt/ethereum-ancient",
              fstype!="rootfs"
            }
          ) > 85
        for: 10m
        labels:
          severity: warning
          component: storage
        annotations:
          summary: "Ethereum ancient filesystem usage is high"
          description: "Ancient-data filesystem usage has exceeded 85% for more than 10 minutes."
          runbook_url: "https://github.com/kemlohko/blockchain-sre-platform/blob/main/docs/runbooks/high-disk-usage.md"

      - alert: GethPeerCountLow
        expr: p2p_peers{job="geth"} < 5
        for: 10m
        labels:
          severity: warning
          component: execution
        annotations:
          summary: "Geth peer count is low"
          description: "Geth has had fewer than 5 peers for more than 10 minutes."
          runbook_url: "https://github.com/kemlohko/blockchain-sre-platform/blob/main/docs/runbooks/geth-low-peer-count.md"

      - alert: LighthousePeerCountLow
        expr: libp2p_peers{job="lighthouse"} < 10
        for: 10m
        labels:
          severity: warning
          component: consensus
        annotations:
          summary: "Lighthouse peer count is low"
          description: "Lighthouse has had fewer than 10 peers for more than 10 minutes."
          runbook_url: "https://github.com/kemlohko/blockchain-sre-platform/blob/main/docs/runbooks/lighthouse-low-peer-count.md"