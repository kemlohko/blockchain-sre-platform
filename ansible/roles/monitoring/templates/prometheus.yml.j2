global:
    scrape_interval: 15s
    evaluation_interval: 15s

rule_files:
    - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - "127.0.0.1:9093"

scrape_configs:
    - job_name: prometheus
      static_configs:
        - targets:
            - "127.0.0.1:9090"

    - job_name: ethereum_node
      static_configs:
        - targets:
            - "{{ ethereum_monitoring_ip }}:9100"
    
    - job_name: geth
      metrics_path: /debug/metrics/prometheus
      static_configs:
        - targets:
            - "{{ ethereum_monitoring_ip }}:6060"
    
    - job_name: lighthouse
      static_configs:
        - targets:
            - "{{ ethereum_monitoring_ip }}:5054"